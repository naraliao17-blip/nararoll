---
import fs from 'node:fs';
import path from 'node:path';
import { getCollection } from 'astro:content';
import { siteConfig } from '../site.config';
import { slugify } from '../utils/slugify';
import '../themes/base.css';

export interface Props {
  title?: string;
  description?: string;
}

const { title, description } = Astro.props;
const pageTitle = title ? `${title} — ${siteConfig.title}` : siteConfig.title;
const pageDescription = description || siteConfig.description;

// Load the active theme's CSS by reading the file at build time. To switch
// themes, change `theme` in src/site.config.ts — nothing else to touch.
const themePath = path.resolve('./src/themes', `${siteConfig.theme}.css`);
const themeCss = fs.readFileSync(themePath, 'utf-8');

// The sidebar is the site's table of contents. Photo posts split into named
// Series (grouped) and one-off Journal entries; everything else is Writing.
// This runs on every page since the sidebar is shared chrome.
const allPosts = (await getCollection('posts')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const photoPosts = allPosts.filter((p) => p.data.cover && !p.data.hideFromPortfolio);
const writingPosts = allPosts.filter((p) => !p.data.cover || p.data.hideFromPortfolio);

const seriesNames: string[] = [];
photoPosts.forEach((p) => {
  if (p.data.series && !seriesNames.includes(p.data.series)) seriesNames.push(p.data.series);
});
const journalPosts = photoPosts.filter((p) => !p.data.series);

const currentPath = Astro.url.pathname.replace(/\/$/, '');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;1,400&family=EB+Garamond:ital@0;1&family=Jost:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <style set:html={themeCss} />
  </head>
  <body>
    <div class="shell">
      <aside class="sidebar">
        <p class="sidebar-title"><a href="/">{siteConfig.title}</a></p>

        <nav class="sidebar-nav">
          <p class="sidebar-group-label">
            <a href="/portfolio" aria-current={currentPath === '/portfolio' ? 'page' : undefined}>Works</a>
          </p>
          <ul>
            {seriesNames.map((name) => (
              <li>
                <a
                  href={`/series/${slugify(name)}`}
                  aria-current={currentPath === `/series/${slugify(name)}` ? 'page' : undefined}
                >
                  {name}
                </a>
              </li>
            ))}
            {journalPosts.length > 0 && (
              <li>
                <a href="/portfolio#journal" class="sidebar-subtle">Journal</a>
              </li>
            )}
          </ul>

          <p class="sidebar-group-label">
            <a href="/writing" aria-current={currentPath === '/writing' ? 'page' : undefined}>Writing</a>
          </p>
          <ul>
            {writingPosts.map((post) => (
              <li>
                <a
                  href={`/posts/${post.slug}`}
                  aria-current={currentPath === `/posts/${post.slug}` ? 'page' : undefined}
                >
                  {post.data.title}
                </a>
              </li>
            ))}
          </ul>

          <p class="sidebar-group-label">
            <a href="/about" aria-current={currentPath === '/about' ? 'page' : undefined}>Profile</a>
          </p>
          <p class="sidebar-group-label">
            <a href="/contact" aria-current={currentPath === '/contact' ? 'page' : undefined}>Contact</a>
          </p>
        </nav>
      </aside>

      <div class="content">
        <main>
          <slot />
        </main>

        <footer class="site-footer">
          <p>{siteConfig.title} — film photography and writing.</p>
        </footer>
      </div>
    </div>

    <button id="to-top" aria-label="Scroll to top">↑</button>

    <script>
      const btn = document.getElementById('to-top');
      const toggle = () => btn?.classList.toggle('visible', window.scrollY > 400);
      window.addEventListener('scroll', toggle, { passive: true });
      toggle();
      btn?.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));
    </script>
  </body>
</html>
