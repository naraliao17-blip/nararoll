---
import fs from 'node:fs';
import path from 'node:path';
import { getCollection } from 'astro:content';
import { siteConfig } from '../site.config';
import { slugify } from '../utils/slugify';
import '../themes/base.css';

export interface Props {
  title?: string;
  description?: string;
}

const { title, description } = Astro.props;
const pageTitle = title ? `${title} — ${siteConfig.title}` : siteConfig.title;
const pageDescription = description || siteConfig.description;

// Load the active theme's CSS by reading the file at build time. To switch
// themes, change `theme` in src/site.config.ts — nothing else to touch.
const themePath = path.resolve('./src/themes', `${siteConfig.theme}.css`);
const themeCss = fs.readFileSync(themePath, 'utf-8');

// The Menu overlay is the site's table of contents. Photo posts split into
// named Series (grouped) and one-off Journal entries; everything else is
// Writing. This runs on every page since the menu is shared chrome.
const allPosts = (await getCollection('posts')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const photoPosts = allPosts.filter((p) => p.data.cover && !p.data.hideFromPortfolio);
const writingPosts = allPosts.filter((p) => !p.data.cover || p.data.hideFromPortfolio);

const seriesNames: string[] = [];
photoPosts.forEach((p) => {
  if (p.data.series && !seriesNames.includes(p.data.series)) seriesNames.push(p.data.series);
});
const journalPosts = photoPosts.filter((p) => !p.data.series);

const currentPath = Astro.url.pathname.replace(/\/$/, '');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;1,400&family=EB+Garamond:ital@0;1&family=Jost:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <style set:html={themeCss} />
  </head>
  <body>
    <header class="topbar">
      <a class="topbar-title" href="/">{siteConfig.title}</a>
      <button id="menu-open" class="topbar-link" aria-haspopup="true" aria-expanded="false" aria-controls="menu-overlay">Menu</button>
    </header>

    <nav id="menu-overlay" class="menu-overlay" aria-hidden="true">
      <div class="topbar menu-overlay-top">
        <a class="topbar-title" href="/">{siteConfig.title}</a>
        <button id="menu-close" class="topbar-link">Close</button>
      </div>

      <div class="menu-columns">
        <div class="menu-col-main">
          <p><a href="/portfolio" aria-current={currentPath === '/portfolio' ? 'page' : undefined}>Works</a></p>
          <p><a href="/writing" aria-current={currentPath === '/writing' ? 'page' : undefined}>Writing</a></p>
          <p><a href="/about" aria-current={currentPath === '/about' ? 'page' : undefined}>Profile</a></p>
          <p><a href="/contact" aria-current={currentPath === '/contact' ? 'page' : undefined}>Contact</a></p>
        </div>

        <div class="menu-col-sub">
          {(seriesNames.length > 0 || journalPosts.length > 0) && (
            <div class="menu-sub-group">
              {seriesNames.map((name) => (
                <p>
                  <a
                    href={`/series/${slugify(name)}`}
                    aria-current={currentPath === `/series/${slugify(name)}` ? 'page' : undefined}
                  >
                    {name}
                  </a>
                </p>
              ))}
              {journalPosts.length > 0 && (
                <p><a href="/portfolio#journal">Journal</a></p>
              )}
            </div>
          )}

          {writingPosts.length > 0 && (
            <div class="menu-sub-group">
              {writingPosts.map((post) => (
                <p>
                  <a
                    href={`/posts/${post.slug}`}
                    aria-current={currentPath === `/posts/${post.slug}` ? 'page' : undefined}
                  >
                    {post.data.title}
                  </a>
                </p>
              ))}
            </div>
          )}
        </div>
      </div>
    </nav>

    <main class="page">
      <slot />
    </main>

    <footer class="site-footer">
      <p>{siteConfig.title} — film photography and writing.</p>
    </footer>

    <button id="to-top" aria-label="Scroll to top">↑</button>

    <script>
      const openBtn = document.getElementById('menu-open');
      const closeBtn = document.getElementById('menu-close');
      const overlay = document.getElementById('menu-overlay');

      const setOpen = (open: boolean) => {
        overlay?.classList.toggle('open', open);
        overlay?.setAttribute('aria-hidden', open ? 'false' : 'true');
        openBtn?.setAttribute('aria-expanded', open ? 'true' : 'false');
        document.body.classList.toggle('menu-locked', open);
      };

      openBtn?.addEventListener('click', () => setOpen(true));
      closeBtn?.addEventListener('click', () => setOpen(false));
      overlay?.addEventListener('click', (e) => {
        if (e.target === overlay) setOpen(false);
      });
      window.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') setOpen(false);
      });

      const btn = document.getElementById('to-top');
      const toggle = () => btn?.classList.toggle('visible', window.scrollY > 400);
      window.addEventListener('scroll', toggle, { passive: true });
      toggle();
      btn?.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));
    </script>
  </body>
</html>
