---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  const tags = new Set<string>();
  posts.forEach((p) => p.data.tags.forEach((t: string) => tags.add(t)));

  return Array.from(tags).map((tag) => {
    const filtered = posts
      .filter((p) => p.data.tags.includes(tag))
      .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
    return { params: { tag }, props: { tag, posts: filtered } };
  });
}

const { tag, posts } = Astro.props;
---

<Layout title={`#${tag}`}>
  <h1 class="hero-title" style="margin-bottom: 10vh;">#{tag}</h1>
  <div class="post-list">
    {posts.map((post: any) => (
      <article class="post-list-item">
        <h2 class="post-list-title"><a href={`/posts/${post.slug}`}>{post.data.title}</a></h2>
        <p class="post-meta">
          {post.data.date.toLocaleDateString('en-GB', { year: 'numeric', month: 'long', day: 'numeric' })}
        </p>
        {post.data.excerpt && <p class="post-excerpt">{post.data.excerpt}</p>}
      </article>
    ))}
  </div>
</Layout>
