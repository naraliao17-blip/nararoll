---
import Layout from '../layouts/Layout.astro';
---

<Layout title="About">
  <h1 class="post-list-title" style="font-size:26px; margin-bottom:24px;">About</h1>
  <div class="post-body">
    <p>
      Write a couple of paragraphs about yourself here — this file is at
      <code>src/pages/about.astro</code>. Everything between the
      <code>&lt;div class="post-body"&gt;</code> tags is plain text you can edit
      directly on GitHub.
    </p>
  </div>
</Layout>
