---
import Layout from '../layouts/Layout.astro';
import { siteConfig } from '../site.config';
---

<Layout title="Profile">
  <div class="profile">
    {siteConfig.avatar && (
      <img class="profile-avatar" src={siteConfig.avatar} alt={siteConfig.title} />
    )}
    <h1 class="post-list-title" style="font-size:26px; margin: 0 0 24px;">Profile</h1>
    <div class="post-body">
      {siteConfig.bio.split('\n\n').map((para) => <p>{para}</p>)}
    </div>
  </div>
</Layout>
