---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

// Every post with a cover photo shows up here automatically — no need to
// maintain a separate photo list. Set `hideFromPortfolio: true` in a post's
// frontmatter to keep a photo out of this grid.
const photoPosts = (await getCollection('posts'))
  .filter((p) => p.data.cover && !p.data.hideFromPortfolio)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Layout title="Photography">
  <h1 class="post-list-title" style="font-size:20px; margin-bottom:14vh; text-align:center;">Photography</h1>
  <div class="grid">
    {photoPosts.map((post) => (
      <a class="grid-item" href={`/posts/${post.slug}`}>
        <img src={post.data.cover} alt={post.data.title} loading="lazy" />
        <span class="grid-caption">{post.data.title}</span>
      </a>
    ))}
  </div>
</Layout>
