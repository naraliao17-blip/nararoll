---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const allPosts = (await getCollection('posts')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const photoPosts = allPosts.filter((p) => p.data.cover && !p.data.hideFromPortfolio).slice(0, 6);
const recentPosts = allPosts.slice(0, 5);
---

<Layout>
  <section class="home-hero">
    <p>Film photography and writing, posted as it comes.</p>
  </section>

  <section class="home-section">
    <p class="home-section-title">
      <span>Photography</span>
      <a href="/portfolio">View all →</a>
    </p>
    <div class="grid">
      {photoPosts.map((post) => (
        <a class="grid-item" href={`/posts/${post.slug}`}>
          <img src={post.data.cover} alt={post.data.title} loading="lazy" />
          <span class="grid-caption">{post.data.title}</span>
        </a>
      ))}
    </div>
  </section>

  <section class="home-section">
    <p class="home-section-title">
      <span>Writing</span>
      <a href="/writing">View all →</a>
    </p>
    <div class="post-list">
      {recentPosts.map((post) => (
        <article class="post-list-item">
          <h2 class="post-list-title"><a href={`/posts/${post.slug}`}>{post.data.title}</a></h2>
          <p class="post-meta">
            {post.data.date.toLocaleDateString('en-GB', { year: 'numeric', month: 'long', day: 'numeric' })}
          </p>
          {post.data.excerpt && <p class="post-excerpt">{post.data.excerpt}</p>}
        </article>
      ))}
    </div>
  </section>
</Layout>
