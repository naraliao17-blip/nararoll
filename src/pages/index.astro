---
// The homepage is the "currently showing" work — the latest series, shown
// large with no grid chrome. Display style ('single' full-bleed image or a
// 'grid' of up to four) is set in src/site.config.ts. Clicking any image
// opens that series' page, not the individual post — the homepage is a
// doorway into the series, like a gallery wall.
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { siteConfig } from '../site.config';
import { slugify } from '../utils/slugify';

const photoPosts = (await getCollection('posts'))
  .filter((p) => p.data.cover && !p.data.hideFromPortfolio)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const latestSeries = photoPosts.find((p) => p.data.series)?.data.series;
const heroPosts = latestSeries
  ? photoPosts.filter((p) => p.data.series === latestSeries)
  : photoPosts.slice(0, 1);

const heroYear = heroPosts.length
  ? new Date(Math.min(...heroPosts.map((p) => p.data.date.getTime()))).getFullYear()
  : null;

// Every image on the homepage links to the series as a whole (the doorway
// behaviour), falling back to the single post itself when there's no series
// to link to yet.
const heroHref = latestSeries
  ? `/series/${slugify(latestSeries)}`
  : heroPosts[0]
    ? `/posts/${heroPosts[0].slug}`
    : null;

const displayPosts = siteConfig.homepageStyle === 'grid' ? heroPosts.slice(0, 4) : heroPosts.slice(0, 1);
---

<Layout>
  {heroPosts.length > 0 && heroHref ? (
    <>
      <section class="hero">
        <h1 class="hero-title">
          <a href={heroHref}>{latestSeries ?? heroPosts[0].data.title}</a>
        </h1>
        {heroYear && <p class="hero-year">{heroYear}</p>}
      </section>

      {siteConfig.homepageStyle === 'grid' ? (
        <div class="grid-2col hero-grid">
          {displayPosts.map((post) => (
            <a href={heroHref} title={latestSeries ?? post.data.title}>
              <img src={post.data.cover} alt={post.data.title} loading="lazy" />
            </a>
          ))}
        </div>
      ) : (
        <div class="hero-images hero-single">
          <a href={heroHref} title={latestSeries ?? displayPosts[0].data.title}>
            <img class="hero-full" src={displayPosts[0].data.cover} alt={displayPosts[0].data.title} loading="lazy" />
          </a>
        </div>
      )}
    </>
  ) : (
    <section class="hero">
      <p class="hero-year">Nothing posted yet — start with <a href="/writing">Writing</a>.</p>
    </section>
  )}
</Layout>
